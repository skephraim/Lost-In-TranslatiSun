# Copy this file to .env.local and fill in whichever section you're using.
# .env.local is gitignored — your key never gets committed.

# Which backend the agents run on: "qwen" (default) or "anthropic".
LLM_PROVIDER=qwen

# --- Qwen ---------------------------------------------------------------
# Pick ONE of the routes below.

# Route A: Alibaba Model Studio / DashScope (cloud, needs a key).
# Key from https://bailian.console.alibabacloud.com/ -> API-KEY
DASHSCOPE_API_KEY=sk-...
# Singapore endpoint is the default. If your console is the Beijing region,
# use https://dashscope.aliyuncs.com/compatible-mode/v1 instead.
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# Route B: Ollama on your own machine (free, no key, no network).
#   ollama pull qwen3
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_MODEL=qwen3

# Route C: any other OpenAI-compatible host (OpenRouter, Together, vLLM).
# QWEN_BASE_URL=https://openrouter.ai/api/v1
# QWEN_API_KEY=sk-or-...
# QWEN_MODEL=qwen/qwen3-235b-a22b

# --- Claude (only if LLM_PROVIDER=anthropic) -----------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
