# Copy this file to .env.local and fill in your key.
# .env.local is gitignored — the key never gets committed.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# claude-sonnet-5 ($2/$10 per million tokens in/out) is the cheaper option;
# claude-opus-5 is $5/$25. Both are far more than enough for this workload.
# ROSETTA_MODEL=claude-sonnet-5
